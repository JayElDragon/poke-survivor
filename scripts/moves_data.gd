# 7.1: movimientos exclusivos (como en el original): "only" = Pokedex que pueden aprenderlo.
# Las formas regionales cuentan como su especie (base_dex).
static func allowed(id: String, dex: int, base_dex: int = -1) -> bool:
	if not MOVES.has(id):
		return false
	var o: Array = MOVES[id].get("only", [])
	return o.is_empty() or o.has(dex) or (base_dex > 0 and o.has(base_dex))


static func exclusive(id: String) -> bool:
	return MOVES.has(id) and MOVES[id].has("only")
